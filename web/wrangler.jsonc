// This & That web app: the static build (npm run build:web → dist/) served by
// a Worker with static assets, no code. The API is the other Worker
// (worker/wrangler.jsonc). Deploy: cd web && npx wrangler@4 deploy
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "this-and-that",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "../dist" }
}
